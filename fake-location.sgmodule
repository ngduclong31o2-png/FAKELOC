#!name=Fake Location
#!desc=Đổi vị trí iPhone
[Script]
fakeloc-req = type=http-request,pattern=^https?:\/\/(gs-loc|gs-loc-cn)\.apple\.com\/clls\/wloc,script-path=LINK_JS,requires-body=0
fakeloc-res = type=http-response,pattern=^https?:\/\/(gs-loc|gs-loc-cn)\.apple\.com\/clls\/wloc,script-path=LINK_JS,requires-body=1,binary-body-mode=1,max-size=0,argument=latitude=21.0278&longitude=105.8342&debug=1
[MITM]
hostname = %APPEND% gs-loc.apple.com, gs-loc-cn.apple.com, gsp-ssl.ls.apple.com
